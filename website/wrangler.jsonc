{
	"name": "rabbiyosefdanon",
	"main": "src/worker.js",
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/v/*"
		]
	},
	"r2_buckets": [
		{
			"binding": "VIDEOS",
			"bucket_name": "rabbi-videos"
		},
		{
			"bucket_name": "rabbi-videos",
			"binding": "Y",
			"remote": true
		}
	]
}